{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GEMINI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-growth",
    "profile_settings": {
      "ai-growth": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.example.com",
    "smtp_port": 465,
    "imap_server": "imap.example.com",
    "imap_port": 993,
    "email_address": "dummy@example.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 80,
      "profile": "ai-growth"
    },
    "rss": [
      {"name": "OpenAI Blog", "url": "https://openai.com/blog/rss.xml", "enabled": true, "category": "ai-news", "profile": "ai-growth"},
      {"name": "Anthropic", "url": "https://www.anthropic.com/rss.xml", "enabled": true, "category": "ai-news", "profile": "ai-growth"},
      {"name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-tools", "profile": "ai-growth"},
      {"name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "enabled": true, "category": "ai-tools", "profile": "ai-growth"},
      {"name": "GrowthHackers", "url": "https://growthhackers.com/feed", "enabled": true, "category": "growth", "profile": "ai-growth"},
      {"name": "Lenny's Newsletter", "url": "https://www.lennysnewsletter.com/feed", "enabled": true, "category": "growth", "profile": "ai-growth"},
      {"name": "Reforge Blog", "url": "https://www.reforge.com/blog/rss", "enabled": true, "category": "growth", "profile": "ai-growth"},
      {"name": "人人都是产品经理", "url": "https://www.woshipm.com/feed", "enabled": true, "category": "growth", "profile": "ai-growth"},
      {"name": "鸟哥笔记", "url": "https://www.niaogebiji.com/feed", "enabled": true, "category": "growth", "profile": "ai-growth"}
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {"subreddit": "growthhackers", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 30, "profile": "ai-growth"},
        {"subreddit": "marketing", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 30, "profile": "ai-growth"}
      ],
      "users": [],
      "fetch_comments": 5
    },
    "twitter": {"enabled": false},
    "telegram": {"enabled": false},
    "openbb": {"enabled": false},
    "ossinsight": {"enabled": false},
    "gdelt": {"enabled": false},
    "google_news": {"enabled": false}
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 5,
    "profile_order": ["ai-growth"],
    "category_groups": {
      "ai_growth": {"limit": 5, "categories": ["ai-news", "ai-tools", "growth", "marketing", "product"]}
    },
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false
  }
}
